# Copy to .env and adjust if needed (make up does this for you). Local development values only.
OPENCART_VERSION=3.0.3.9
PHP_VERSION=8.1

OC_PORT=8080
PMA_PORT=8081
MAILPIT_PORT=8025
DB_PORT_HOST=3307

DB_NAME=opencart
DB_USER=opencart
DB_PASSWORD=opencart
DB_ROOT_PASSWORD=root
DB_PREFIX=oc_

# Admin login for http://localhost:8080/admin
OC_ADMIN_USER=admin
OC_ADMIN_PASSWORD=admin
OC_ADMIN_EMAIL=admin@example.com

# MyParcel API the plugin talks to. Use an acceptance API key with this.
MYPARCEL_API_URL=https://api.acceptance.myparcel.nl/

# off | debug | develop,debug  (Xdebug connects to port 9003 on your machine)
XDEBUG_MODE=off
