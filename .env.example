# Copy to .env and adjust if needed (make up does this for you). Local development values only.
# Combinations and how to switch: see CONTRIBUTING.md.
OPENCART_VERSION=3.0.5.0
PHP_VERSION=8.3
DEBIAN_VARIANT=trixie
# Empty: URL and SHA-256 come from .docker/opencart-releases.
OPENCART_ZIP_URL=
OPENCART_ZIP_SHA256=

OC_PORT=8080
PMA_PORT=8081
MAILPIT_PORT=8025
DB_PORT_HOST=3307

DB_NAME=opencart
DB_USER=opencart
DB_PASSWORD=opencart
DB_ROOT_PASSWORD=root
DB_PREFIX=oc_

# Admin login for http://localhost:8080/admin
OC_ADMIN_USER=admin
OC_ADMIN_PASSWORD=admin
OC_ADMIN_EMAIL=admin@example.com

# off | debug | develop,debug  (Xdebug connects to port 9003 on your machine)
XDEBUG_MODE=off
