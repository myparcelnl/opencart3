#!/usr/bin/env bash
# Installs MyParcel extensions in OpenCart, as Extensions > Extensions > Install does.
# Arguments: extensions as <type>/<code>; default: the module and the shipping extension.
# Core answers the install route with a success page even when the install fails,
# so success is the extension's row in oc_extension. Exits 1 when an extension fails.
set -euo pipefail
WEBROOT=/var/www/html
PREFIX="${DB_PREFIX:-oc_}"

extensions=("$@")
if [ "${#extensions[@]}" -eq 0 ]; then
  extensions=(module/myparcelnl shipping/myparcel_shipping)
fi

is_registered() {
  local count
  count="$(mysql -h"${DB_HOST}" -P"${DB_PORT}" -u"${DB_USER}" -p"${DB_PASSWORD}" "${DB_NAME}" -N -e \
    "SELECT COUNT(*) FROM ${PREFIX}extension WHERE type = '$1' AND code = '$2'")"
  [ "${count}" -gt 0 ]
}

# Installs one extension. On failure, logs which check failed and returns 1.
install_extension() {
  local type="${1%%/*}"
  local code="${1#*/}"
  local reason=""

  # The controller file is checked before the oc_extension row, because core also
  # registers a code without a controller file.
  if [[ ! "$1" =~ ^[a-z]+/[a-z0-9_]+$ ]]; then
    reason="invalid name, expected <type>/<code>"
  elif [ ! -f "${WEBROOT}/admin/controller/extension/${type}/${code}.php" ]; then
    reason="no controller file"
  elif ! curl -fs -b /tmp/oc-admin.jar -o /dev/null \
    "http://localhost/admin/index.php?route=extension/extension/${type}/install&extension=${code}&user_token=${token}"; then
    reason="install request failed"
  elif ! is_registered "${type}" "${code}"; then
    reason="not registered in ${PREFIX}extension"
  fi

  if [ -n "${reason}" ]; then
    echo "[opencart] plugin install failed: $1 (${reason})" >&2
    return 1
  fi

  echo "[opencart] plugin installed: $1 (registered in ${PREFIX}extension)"
}

if ! token="$(oc-admin-token)"; then
  for ext in "${extensions[@]}"; do
    echo "[opencart] plugin install failed: ${ext} (no admin login)" >&2
  done
  exit 1
fi

failed=0
for ext in "${extensions[@]}"; do
  install_extension "${ext}" || failed=1
done

exit "${failed}"
