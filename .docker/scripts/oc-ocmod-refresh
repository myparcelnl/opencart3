#!/usr/bin/env bash
# Rebuilds the OCMOD modifications, as Extensions > Modifications > Refresh does.
set -euo pipefail

token="$(oc-admin-token)"
curl -fs -b /tmp/oc-admin.jar -o /dev/null \
  "http://localhost/admin/index.php?route=marketplace/modification/refresh&user_token=${token}"
echo "[opencart] OCMOD modifications refreshed."
